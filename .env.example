# Copy to `.env` and fill in real values

DATABASE_URL=wowauth.db

# 32-byte key, base64-encoded, used to encrypt secrets at rest (client
# secrets, PKCE verifiers, access/refresh tokens). Generate one with:
#   openssl rand -base64 32
WOWAUTH_MASTER_KEY=

# Bearer secret required by every management endpoint (POST/PUT/PATCH/DELETE
# /apps/...). Flat across all apps by design. Generate one the same way as
# WOWAUTH_MASTER_KEY.
CONFIG_SECRET=

# This server's own public URL, no trailing slash. Used to build absolute
# URLs in the OIDC discovery document served at
# /{app_id}/.well-known/openid-configuration.
PUBLIC_BASE_URL=http://localhost:3000

RUST_LOG=info
