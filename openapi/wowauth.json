    "/{app_id}/oauth/auth": {
      "get": {
        "summary": "Start authorization code flow",
        "parameters": [
          {
            "name": "app_id",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "redirect_uri",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "state",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "code_challenge",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "code_challenge_method",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "account_hint",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "description": "Identifies which end-user account this authorization is for\n(e.g. their email), so that re-authorizing the same account\nlater reuses the same user id instead of minting a new one.\nOptional — if omitted, every authorization is treated as a new,\ndistinct user.",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "scope",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects the caller's browser on to the app's upstream provider.",
            "headers": {
              "LOCATION": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        }
      }
    },
    "/{app_id}/oauth/callback": {
      "get": {
        "summary": "Callback endpoint",
        "parameters": [
          {
            "name": "app_id",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "code",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "state",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": true,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "error",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
          },
          {
            "name": "error_description",
            "schema": {
              "type": "string"
            },
            "in": "query",
            "required": false,
            "deprecated": false,
            "explode": true
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects back to the caller's own `redirect_uri`, with either\n`code`/`state` on success or `error`/`error_description`/`state` on\nfailure — standard RFC 6749 §4.1.2 shape either way.",
            "headers": {
              "LOCATION": {
                "required": true,
                "deprecated": false,
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "text/plain; charset=utf-8": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": ""
          }
        }
      }
    },
    "/{app_id}/oauth/token": {
      "post": {
        "summary": "Exchange auth code for token",
        "parameters": [
          {
            "name": "app_id",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
