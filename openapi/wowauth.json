                "$ref": "#/components/schemas/TokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponseBody"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/{app_id}/oauth/revoke": {
      "post": {
        "summary": "Revoke a token (RFC 7009)",
        "parameters": [
          {
            "name": "app_id",
            "schema": {
              "type": "string"
            },
            "in": "path",
            "required": true,
            "deprecated": false,
            "explode": true
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/RevokeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Per RFC 7009, always 200 — whether or not `token` was recognized —\nso this endpoint can't be used to probe for valid tokens."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppStatus": {
        "type": "object",
        "title": "AppStatus",
        "required": [
          "app_id",
          "name",
          "user_count",
          "active_user_count",
          "needs_reauth_count"
        ],
        "properties": {
          "app_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "user_count": {
            "type": "integer",
            "format": "int64"
          },
          "active_user_count": {
            "type": "integer",
            "format": "int64"
          },
          "needs_reauth_count": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AppView": {
        "type": "object",
        "title": "AppView",
        "description": "Never includes `client_secret` — that's write-only through this API.\n`public_key` is fine to echo back, since it's public by design.",
        "required": [
          "id",
          "name",
          "client_id",
          "auth_url",
          "token_url",
          "redirect_url",
          "allowed_redirect_uris",
          "scopes",
          "token_auth_method",
          "extra_auth_params",
          "extra_headers",
          "public_key"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "auth_url": {
            "type": "string"
          },
          "token_url": {
            "type": "string"
          },
          "redirect_url": {
            "type": "string"
          },
          "allowed_redirect_uris": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scopes": {
            "type": "string"
          },
          "token_auth_method": {
            "type": "string"
          },
          "extra_auth_params": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "extra_headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "public_key": {
            "type": "string"
          }
        }
      },
      "CreateAppRequest": {
        "type": "object",
        "title": "CreateAppRequest",
        "required": [
          "name",
          "client_id",
          "client_secret",
          "auth_url",
          "token_url",
          "redirect_url",
          "public_key"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "client_id": {
            "type": "string"
          },
          "client_secret": {
            "type": "string"
          },
          "auth_url": {
            "type": "string"
          },
          "token_url": {
            "type": "string"
          },
          "redirect_url": {
            "type": "string",
            "description": "The redirect URI wowauth registers with the provider."
          },
          "allowed_redirect_uris": {
            "type": "array",
            "description": "Allow-list of redirect URIs the `/oauth/*` facade accepts back from\ncalling clients.",
            "default": [],
            "items": {
              "type": "string"
            }
          },
          "scopes": {
            "type": "string",
            "default": ""
          },
          "token_auth_method": {
            "type": "string",
            "default": "basic"
          },
          "extra_auth_params": {
            "type": "object",
            "default": {},
            "additionalProperties": {
              "type": "string"
            }
          },
          "extra_headers": {
            "type": "object",
            "default": {},
            "additionalProperties": {
